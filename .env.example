# Dadri Plant Control - configuration template
#
# Copy to .env and fill in real values. .env is gitignored; never commit secrets.
# These are read from the process environment, so export them before starting the
# backend (or set them in your PM2 ecosystem file / systemd unit):
#
#   set -a && . ./.env && set +a
#   pm2 start app.py --name dadri-backend --interpreter ./venv/bin/python

# --- Telegram alerts (required for breakdown / predictive / inventory alerts) ---
# Bot token from @BotFather. If either of these is unset, alerts are skipped and
# logged to stdout instead of being sent.
TELEGRAM_BOT_TOKEN=
# Numeric group chat id, including the leading minus for groups, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# --- Photo storage (optional) ---
# Leave blank to store uploads on local disk under static/uploads/.
# Set all three to push photos to S3 instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=dadri-plant-maintenance
AWS_REGION=ap-south-1

# --- QR sticker generation (generate_qrs.py) ---
# Public base URL of the dashboard. QR codes encode <BASE_URL>/m?id=<machine_id>,
# so this must be the HTTPS domain technicians' phones can reach - not localhost.
QR_BASE_URL=https://YOUR_DOMAIN.duckdns.org
